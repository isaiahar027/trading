# Environment variables for the Among Us Trading Desk. Copy to .env (never commit it) or set them in
# the Windows user environment / Task Scheduler action. The desk NEVER needs your UniTrader password:
# you log in to the terminal yourself.

# Pink Sentiment (Claude veto-only reviewer); only needed when llm.enabled: true
ANTHROPIC_API_KEY=

# Market data when feed.kind: twelvedata
TWELVEDATA_API_KEY=

# Dashboard bearer token (>= 24 random characters). If unset, one is generated on first run and saved to
# data/dashboard_token. Required when the dashboard listens on a non-loopback address.
DESK_DASHBOARD_TOKEN=

# Phone alerts (optional): ntfy topic (keep it long and random — anyone who knows it can read it)
DESK_NTFY_TOPIC=
# ... and/or Telegram
DESK_TELEGRAM_BOT_TOKEN=
DESK_TELEGRAM_CHAT_ID=

# Real-money mode only. Must be exactly: I-ACCEPT-REAL-MONEY-RISK
DESK_LIVE_ACK=
