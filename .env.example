# =================================================================================================================
# Odds Decision Hub configuration
#
#   cp .env.example .env    then edit .env    (never commit .env: it holds your API key and password)
#
# Every variable below is optional; the value shown is the built-in default. An empty value also means "use the
# default". Format: KEY=value, one per line, no spaces around "=", no comments on the same line as a value.
# Wrap a value in single quotes if it contains $, # or spaces, e.g. DASHBOARD_PASSWORD='pa$$ word#1'.
#
# Settings marked [dashboard] are only the STARTING values: once you save settings in the dashboard they are stored
# in DATA_DIR/settings.json and win over this file. Delete that file to go back to the values here.
# =================================================================================================================


# -----------------------------------------------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------------------------------------------

# true = simulated odds (no API key, no credits spent). Same as `npm run demo` / `--demo`.
DEMO_MODE=false

# debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------------------------------------------
# The Odds API (https://the-odds-api.com): the only odds data source
# -----------------------------------------------------------------------------------------------------------------

# Your API key (emailed after you pick a plan). Empty = no live odds; the dashboard explains how to add it.
ODDS_API_KEY=

# Size of your monthly plan in credits (500 free, 20000, 100000, ...). Only used until the first API response;
# after that the real remaining count from the x-requests-remaining header drives the budget.
ODDS_API_MONTHLY_CREDITS=20000

# Day of the month (1-28) your quota resets, at 00:00 UTC. Check your Odds API account for your date.
ODDS_API_RESET_DAY=1

# Credits never spent, as a safety margin. With the 500-credit free plan lower this (e.g. 50).
ODDS_API_RESERVE_CREDITS=200

# API endpoint. Leave as is.
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Per-request timeout in milliseconds.
ODDS_API_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------------------------------------------
# Leagues, bookmakers and markets
# Credits per odds call = (number of markets) x ceil(number of bookmakers / 10). Defaults: 3 x ceil(10/10) = 3.
# -----------------------------------------------------------------------------------------------------------------

# [dashboard] Leagues to price. Known keys: NFL, NCAAF, NBA, NCAAB, WNBA, MLB, NHL, EPL, UCL, MLS, LALIGA, SERIEA,
# BUNDESLIGA, LIGUE1, UFC. Fewer leagues = faster polling of the ones you keep.
LEAGUES=NFL,NCAAF,NBA,NCAAB,WNBA,MLB,NHL,EPL,UCL,MLS

# Map a league to a different Odds API sport key, add a new league, or disable one with "none".
# Example: ODDS_API_SPORTS=KBO:baseball_kbo,UFC:none   (a new league must also be listed in LEAGUES to be priced)
ODDS_API_SPORTS=

# Bookmakers requested (Odds API keys). draftkings is always added. An 11th book doubles the credit cost.
ODDS_API_BOOKS=pinnacle,draftkings,fanduel,betmgm,williamhill_us,betonlineag,lowvig,betrivers,bovada,fanatics

# Sharp reference books in priority order; the first one with a fresh, complete market sets the fair price.
# If none has one, a consensus of MIN_CONSENSUS_BOOKS or more books is used instead.
SHARP_BOOKS=pinnacle,betonlineag,lowvig

# Odds API market keys: h2h (moneyline), spreads, totals. Each one adds 1 credit per call per 10 books.
ODDS_API_MARKETS=h2h,spreads,totals

# Ask the feed for bookmaker deep links, used by the "Open in DraftKings" button when available.
ODDS_API_INCLUDE_LINKS=true

# Two-letter US state you bet from (e.g. nj, pa, oh). Fills {state} in DraftKings links. Empty = generic link.
BOOK_STATE=


# -----------------------------------------------------------------------------------------------------------------
# Credit budget / polling
# The scheduler spreads (remaining credits - reserve) evenly over the hours left until the reset day, and gives
# live leagues 4x the share of leagues that are only pre-match. These are hard limits on top of that.
# -----------------------------------------------------------------------------------------------------------------

# Never poll a live league more often than this (seconds).
ODDS_API_MIN_INTERVAL_LIVE_SEC=20

# Never poll a pre-match-only league more often than this (seconds).
ODDS_API_MIN_INTERVAL_PREMATCH_SEC=180

# Target longest interval between polls of an active league (seconds). A tight budget can still stretch it.
ODDS_API_MAX_INTERVAL_SEC=1800

# A league only spends credits when it is live or has a game starting within this many hours.
# Lower it (e.g. 6) to save credits for live games.
ODDS_API_PREMATCH_HORIZON_HOURS=24


# -----------------------------------------------------------------------------------------------------------------
# Dashboard web server
# -----------------------------------------------------------------------------------------------------------------

# Interface to listen on. Keep 127.0.0.1 for local runs. Ignored under Docker Compose (docker-compose.yml sets
# 0.0.0.0 inside the container and publishes the port on the server's 127.0.0.1 only).
HOST=127.0.0.1

# Port to listen on. Ignored under Docker Compose (always 8080 inside the container; change the host side of the
# "ports" mapping in docker-compose.yml instead).
PORT=8080

# HTTP Basic auth for the dashboard. Empty password = no login prompt, which is only acceptable while the port is
# reachable from this machine alone (localhost / SSH tunnel). Set a long random one for any other setup:
#   openssl rand -base64 24
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Where settings.json and the bet journal are stored. Ignored under Docker Compose (/app/data, mounted from ./data).
DATA_DIR=./data

# Time zone that defines "today" for the daily exposure limit. Also used by docker-compose.yml.
TZ=America/New_York


# -----------------------------------------------------------------------------------------------------------------
# Bankroll and staking   [dashboard] = starting value, editable later in the dashboard Settings
# -----------------------------------------------------------------------------------------------------------------

# [dashboard] Money set aside for betting, in dollars.
BANKROLL=1000

# [dashboard] Fraction of full Kelly to bet (0.01-1). 0.25 = quarter Kelly.
KELLY_MULTIPLIER=0.25

# [dashboard] Largest single stake as a fraction of bankroll (0.02 = 2%).
MAX_STAKE_PCT=0.02

# [dashboard] Largest single stake in dollars.
MAX_STAKE_ABS=100

# [dashboard] Most you may stake in one calendar day (in TZ), as a fraction of bankroll (0.15 = 15%).
MAX_DAILY_EXPOSURE_PCT=0.15

# [dashboard] Minimum expected value for a BET verdict before the game (0.02 = +2%). Dashboard allows 0-0.5.
MIN_EV_PREMATCH=0.02

# [dashboard] Minimum expected value for a BET NOW verdict on a live game (0.03 = +3%). Dashboard allows 0-0.5.
MIN_EV_LIVE=0.03

# [dashboard] Edges from this EV up to the minimum above are shown as WATCH. Must not exceed either minimum.
WATCH_EV=0.005

# [dashboard] Also show DraftKings-vs-other-book arbitrage pairs (the other leg is at a different sportsbook).
SHOW_ARBS=true


# -----------------------------------------------------------------------------------------------------------------
# Model tuning (the defaults are deliberately conservative; change only if you know why)
# -----------------------------------------------------------------------------------------------------------------

# How the sharp book's margin is removed: worst | multiplicative | additive | power | shin.
# "worst" takes, per outcome, the lowest probability of the four methods, so an edge must survive all of them.
DEVIG_METHOD=worst

# Minimum number of non-DraftKings books for a consensus fair price when no sharp book is usable.
MIN_CONSENSUS_BOOKS=3

# Oldest sharp (reference) price still trusted, in seconds: live games / before the game.
LIVE_MAX_SHARP_AGE_SEC=45
PREMATCH_MAX_SHARP_AGE_SEC=900

# Oldest DraftKings price still trusted, in seconds: live games / before the game.
LIVE_MAX_DK_AGE_SEC=45
PREMATCH_MAX_DK_AGE_SEC=600

# Stale line: the sharp book's implied probability moved at least this much (0.02 = 2 points) within
# STALE_WINDOW_SEC seconds while DraftKings did not move.
STALE_MOVE_PROB=0.02
STALE_WINDOW_SEC=120

# Edges above this EV are treated as bad data (mismatched lines, stale feed) and hidden. 0.25 = +25%.
MAX_PLAUSIBLE_EV=0.25

# How long a vanished opportunity stays on screen, greyed out as "gone" (seconds).
GONE_RETENTION_SEC=90

# Ignore DraftKings prices longer than this decimal price (11 = +1000).
MAX_DECIMAL_ODDS=11

# Also evaluate alternate spread/total lines, not just the main line.
INCLUDE_ALT_LINES=false


# -----------------------------------------------------------------------------------------------------------------
# Phone / desktop alerts (all optional; any combination). Treat these URLs and tokens like passwords.
# -----------------------------------------------------------------------------------------------------------------

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# ntfy: full topic URL; pick a long random topic name, anyone who knows it can read it.
# Example: NTFY_URL=https://ntfy.sh/odds-hub-7f3kq9x2m1
NTFY_URL=

# Telegram: create a bot with @BotFather for the token, message your bot once, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates ("chat":{"id":...}). Both values are required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lowest urgency that triggers an alert: critical | high | medium.
NOTIFY_MIN_URGENCY=critical

# Minimum seconds between two alerts for the same opportunity.
NOTIFY_COOLDOWN_SEC=300
